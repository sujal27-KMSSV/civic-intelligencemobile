**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Coverage related
coverage/
*.lcov
*.info

# Local env + runtime artifacts
backend/.env
backend/staticfiles/
backend/media/
backend/.venv/
backend/venv/
backend/db.sqlite3
backend/*.err.log

# Render CLI session
~/.render/

# AI service (FastAPI sidecar): venv, downloaded weights, trained-joblib and
# SQLite-less caches are runtime artifacts; keep the meta/manifest JSON tracked.
ai_service/.venv/
ai_service/datasets/
ai_service/artifacts/*.joblib
ai_service/models/
ai_service/yolov8n.pt
ai_service/**/__pycache__/
ai_service/.pytest_cache/

# Private release assets (keystore backups, signing properties) — never share
release/private/

# Backup recovery point + any signing material anywhere under it — untracked
backup/

# Release binaries stay untracked (verified artifact convention)
release/*.apk
release/*.aab
# Authority Admin (React + Vite). The nested authority-web/.gitignore also
# covers these; repeated here so the rules are obvious from the repo root.
authority-web/node_modules/
authority-web/dist/
authority-web/.env
authority-web/.env.local
authority-web/.env.*.local
authority-web/*.tsbuildinfo
