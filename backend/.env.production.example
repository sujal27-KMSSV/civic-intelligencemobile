# ===========================================================================
# Production environment template (never commit a real .env).
#
# Copy to `.env` or export in your hosting platform (Render/Railway/Fly/etc.)
#   cp .env.production.example .env
#
# Generated, placeholders only.
# ===========================================================================

# --- Core (REQUIRED in production) ------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Hosts that may reach this server, comma-separated. ALWAYS set the real
# domains in production (e.g. api.example.com,www.example.com).
ALLOWED_HOSTS=api.example.com

DEBUG=False

# --- Database ---------------------------------------------------------------
# Production should use PostgreSQL. Any standard managed Postgres works; for a
# permanently-free option that needs no card, use Neon (neon.tech) with its
# pooled host (the "...-pooler.<region>.aws.neon.tech" hostname).
DB_ENGINE=postgresql
DB_NAME=civic_intelligence
DB_USER=civic
DB_PASSWORD=CHANGE_ME
DB_HOST=ep-xxx-pooler.us-east-2.aws.neon.tech
DB_PORT=5432
# Required by external managed Postgres (Neon/Supabase/Aiven) over TLS.
DB_SSLMODE=require
# Optional libpq channel binding (Neon connection strings include
# channel_binding=require; set it if the provider asks for it).
# DB_CHANNEL_BINDING=require
# Reuse TLS connections (seconds) so a scale-to-zero DB stays warm between
# requests; keep below the provider's idle-suspend window.
DB_CONN_MAX_AGE=60
# Seconds to wait for the initial connection before failing.
DB_CONNECT_TIMEOUT=10

# --- HTTPS / proxy ----------------------------------------------------------
# True when behind a TLS-terminating reverse proxy (Render/Railway do this).
SECURE_SSL_REDIRECT=True
# HTTP Strict-Transport-Security. Set once the site is HTTPS-only everywhere.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Origins allowed to POST cross-site (the authority dashboard, if hosted on a
# different domain than this API):  https://admin.example.com
CSRF_TRUSTED_ORIGINS=

# --- CORS (Flutter app origins) ---------------------------------------------
# The production mobile app uses a fixed HTTPS host, so allow ONLY that origin.
# (The release APK must be built against the same host.)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://api.example.com

# --- Optional AI sidecar (ai_service/) --------------------------------------
# http(s) URL of the FastAPI service. Leave EMPTY to keep the rule-based engine
# (exactly like v2). Render free tier cannot host torch; unset in demo.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=4

# --- Optional genuine PostGIS (geospat app) ----------------------------------
# Only ever "True" with DB_ENGINE=postgresql on a database that actually has
# the PostGIS extension + a runtime with GDAL. Free Render Postgres does NOT
# have it — keep False there. See docs/postgis.md.
GEOSPAT_ENABLED=False

# --- One-time staff admin bootstrap (hosts WITHOUT an interactive shell) -----
# Set CIVIC_BOOTSTRAP_ADMIN_EMAIL and the Dockerfile CMD runs
# `manage.py bootstrap_admin` ONCE on the next boot (idempotent; it never
# resets an existing password). Prefer a provider Shell / `manage.py
# bootstrap_admin` where one is available. The generated password is printed
# once to the service's private deploy logs; set CIVIC_ADMIN_PASSWORD to choose
# your own instead. REMOVE these two variables after the account exists.
# CIVIC_BOOTSTRAP_ADMIN_EMAIL=authority@example.com
# CIVIC_BOOTSTRAP_ADMIN_SUPERUSER=1
# CIVIC_ADMIN_PASSWORD=