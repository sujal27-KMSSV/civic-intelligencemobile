# Copy to `.env` and adjust for your machine. Never commit the real `.env`.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database — leave DB_ENGINE unset (or "sqlite") for local SQLite.
DB_ENGINE=sqlite
DB_NAME=civic_intelligence
DB_USER=civic
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True