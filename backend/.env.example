# Copy to `.env` and adjust for your machine. Never commit the real `.env`.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database — leave DB_ENGINE unset (or "sqlite") for local SQLite.
DB_ENGINE=sqlite
DB_NAME=civic_intelligence
DB_USER=civic
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# Optional AI sidecar (ai_service/). Empty = rule-based engine only.
AI_SERVICE_URL=http://127.0.0.1:8010
AI_SERVICE_TIMEOUT=4

# Optional genuine PostGIS (requires PostgreSQL + PostGIS + GDAL).
GEOSPAT_ENABLED=False
# W_GPS=0.24  W_CATEGORY=0.10  W_TEXT=0.20  W_IMAGE=0.21  W_EMBEDDING=0.25